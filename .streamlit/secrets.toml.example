# Escolha "oidc" (recomendado em produção) ou "local".
APP_AUTH_MODE = "local"
APP_ALLOWED_EMAILS = "seu-email@exemplo.com,professora@exemplo.com"

# Somente no modo local. Gere o hash com: python scripts/hash_password.py
APP_USERS_JSON = '''
{
  "seu-email@exemplo.com": {
    "name": "Administrador",
    "password_hash": "pbkdf2_sha256$600000$SALT_BASE64$HASH_BASE64"
  },
  "professora@exemplo.com": {
    "name": "Professora",
    "password_hash": "pbkdf2_sha256$600000$SALT_BASE64$HASH_BASE64"
  }
}
'''

JAM_API_BASE = "https://core.proxy.prod.us-west-2.prod.jam.training.aws.dev"
JAM_TOKEN_REFRESH_ENABLED = true
JAM_TOKEN_REFRESH_URL = "https://vs.aws.amazon.com/token"
JAM_TOKEN_REFRESH_METHOD = "POST"
JAM_TOKEN_REFRESH_MIN_INTERVAL_SECONDS = 900
JAM_TOKEN_REFRESH_COOKIE = "COOKIE_DA_SESSAO_AWS"
JAM_TOKEN_REFRESH_HEADERS_JSON = '''{"content-type":"application/json"}'''
JAM_TOKEN_REFRESH_BODY_JSON = '''{}'''

SQLITE_PATH = "./jam_mapper.db"
EXPORT_PATH = "./exports"

# Para OIDC, remova APP_USERS_JSON, use APP_AUTH_MODE="oidc" e configure:
